# Server
PORT=4000

# The public origin used inside QR codes. For phones on the same Wi-Fi use your
# computer's LAN address, e.g. http://192.168.1.20:5173
APP_URL=http://localhost:5173

# Replace this with a long random string before deploying.
JWT_SECRET=change-me-to-a-long-random-string

# "demo" shows a safe simulated payment confirmation.
# "razorpay" enables Razorpay Checkout + signed webhooks.
PAYMENT_MODE=demo

# Only needed when PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo account overrides (optional)
SEED_ADMIN_EMAIL=admin@smartdine.app
SEED_ADMIN_PASSWORD=Admin@123
SEED_KITCHEN_EMAIL=kitchen@smartdine.app
SEED_KITCHEN_PASSWORD=Kitchen@123
